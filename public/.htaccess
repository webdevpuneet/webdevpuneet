Options -Indexes

<IfModule mod_rewrite.c>

RewriteEngine On

# Backend / server-side tools live on fwdtools.com (database-schema-designer since 2026-10-22, the rest moved back 2026-10-26)
RewriteRule ^(database-schema-designer|sql-formatter|htaccess-redirect-generator|security-headers-generator|api-mock-generator|api-request-generator-tester|json-schema-generator|xml-formatter)(/.*)?$ https://fwdtools.com/$1/ [R=301,L]

# Backend playgrounds moved back to fwdtools.com (2026-10-26)
RewriteRule ^(nodejs|express|python|php|sql|mongo|redis|graphql|firebase|git|rest-api-builder)-playground(/.*)?$ https://fwdtools.com/$1-playground/ [R=301,L]

# --------------------------------------------------
# Redirect www to non-www (canonical host)
# --------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.webdevpuneet\.com$ [NC]
RewriteRule ^ https://webdevpuneet.com%{REQUEST_URI} [L,R=301]

# --------------------------------------------------
# Redirect HTTP to HTTPS
# --------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --------------------------------------------------
# Remove duplicate slashes anywhere in URL
# --------------------------------------------------
RewriteCond %{REQUEST_URI} ^(.*)//+(.*)$
RewriteRule ^ %1/%2 [R=301,L,NE]

# --------------------------------------------------
# Renamed routes (301)
# /ui-snippets/tag/ -> /ui-snippets/   (the bare tag index only; the
#   individual /ui-snippets/tag/<tag>/ pages are untouched)
# --------------------------------------------------
RewriteRule ^ui-snippets/tag/?$ /ui-snippets/ [R=301,L]

# /website-section-templates/article-text/ was renamed to /website-section-templates/privacy-policy/
RewriteRule ^website-section-templates/article-text/?$ /website-section-templates/privacy-policy/ [R=301,L]

# /website-builder/templates/ -> /website-builder/   (the template gallery moved to the
#   builder's landing page; template pages /website-builder/templates/<id>/ are untouched)
RewriteRule ^website-builder/templates/?$ /website-builder/ [R=301,L]

# --------------------------------------------------
# Return 410 Gone for all /updates/ pages
# Examples:
# /bookmark-keeper/updates/
# /html-playground/updates/
# --------------------------------------------------
RewriteRule ^(.+)/updates/?$ - [G,L]

# --------------------------------------------------
# Add trailing slash to extensionless URLs
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# --------------------------------------------------
# Serve .html files for trailing-slash URLs
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1.html [L,QSA]

</IfModule>

# --------------------------------------------------
# Custom 404
# --------------------------------------------------
ErrorDocument 404 /404.html